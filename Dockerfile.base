# Build all three Jsonnet tools from the same pinned release.
FROM debian:trixie-slim AS jsonnet-tools
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
ARG JSONNET_VERSION=0.20.0
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates golang-go && \
    rm -rf /var/lib/apt/lists/*
RUN GOBIN=/out CGO_ENABLED=0 go install \
    github.com/google/go-jsonnet/cmd/jsonnet@v${JSONNET_VERSION} \
    github.com/google/go-jsonnet/cmd/jsonnetfmt@v${JSONNET_VERSION} \
    github.com/google/go-jsonnet/cmd/jsonnet-lint@v${JSONNET_VERSION}

FROM debian:trixie-slim AS toolchain
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# ---------------------------------------------------------------------------
# Build args: hardcode current versions for layer caching.
# These rarely change; when they do, only the affected layer rebuilds.
# ---------------------------------------------------------------------------
ARG NODE_VERSION=18.18.2
ARG OPAM_VERSION=2.3.0
ARG FORGE_VERSION=1.5.0
ARG HADOLINT_VERSION=2.12.0

# ---------------------------------------------------------------------------
# Layer 1: System packages + kernel cross-compilation tools
# ---------------------------------------------------------------------------
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git pkg-config sudo \
      autoconf automake libtool cmake m4 patch perl wget unzip rsync file \
      jq ripgrep less glab xxd \
      python3 python3-pip python3-venv pre-commit shellcheck shfmt \
      cargo clang musl-tools wabt binutils-gold \
      binutils-riscv64-unknown-elf gcc-riscv64-linux-gnu \
      # opam depexts commonly needed by octez
      libgmp-dev libev-dev libffi-dev libhidapi-dev zlib1g-dev \
      libpq-dev libsqlite3-dev libzstd-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=jsonnet-tools /out/ /usr/local/bin/
RUN case "$(dpkg --print-architecture)" in \
      amd64) hadolint_arch=x86_64 ;; \
      arm64) hadolint_arch=arm64 ;; \
      *) echo 'Unsupported hadolint architecture' >&2; exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-Linux-${hadolint_arch}" \
      -o /usr/local/bin/hadolint && \
    chmod +x /usr/local/bin/hadolint

# Repository work and per-user toolchains belong to the default developer.
# Upstream opam depext installation needs sudo for system packages.
RUN groupadd --gid 1000 dev && \
    useradd --uid 1000 --gid dev --create-home --shell /bin/bash dev && \
    echo 'dev ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/dev && \
    chmod 0440 /etc/sudoers.d/dev && \
    install -d -o dev -g dev /home/dev/tezos /opt/cargo-export
ENV HOME=/home/dev

# RISC-V cross-compilation symlink
RUN ln -sf /usr/bin/riscv64-linux-gnu-gcc /usr/bin/riscv64-unknown-linux-musl-gcc

# ---------------------------------------------------------------------------
# Layer 2: opam (downloaded from GitHub releases)
# ---------------------------------------------------------------------------
RUN ARCH="$(dpkg --print-architecture)" && \
    case "$ARCH" in \
      amd64) OPAM_ARCH=x86_64-linux ;; \
      arm64) OPAM_ARCH=arm64-linux ;; \
      *) echo "Unsupported architecture: $ARCH" && exit 1 ;; \
    esac && \
    TAG=$(echo "$OPAM_VERSION" | tr '~' '-') && \
    curl -fsSL "https://github.com/ocaml/opam/releases/download/${TAG}/opam-${TAG}-${OPAM_ARCH}" \
      -o /usr/local/bin/opam && \
    chmod +x /usr/local/bin/opam

# ---------------------------------------------------------------------------
# Layer 3: rustup + sccache (the checkout selects the Rust toolchain below)
# ---------------------------------------------------------------------------
ENV RUSTUP_HOME=/home/dev/.rustup \
    CARGO_HOME=/home/dev/.cargo \
    PATH="/home/dev/.cargo/bin:${PATH}"

ARG SCCACHE_VERSION=0.10.0
RUN curl -fsSL "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl.tar.gz" | \
      tar xz -C /usr/local/bin --strip-components=1 "sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl/sccache" && \
    mv /usr/local/bin/sccache /usr/local/bin/sccache.bin && \
    printf '#!/bin/sh\nexport TMPDIR=/tmp/sccache-tmp\nmkdir -p "$TMPDIR"\nexec sccache.bin "$@"\n' \
      > /usr/local/bin/sccache && \
    chmod +x /usr/local/bin/sccache

USER dev
WORKDIR /home/dev
RUN opam init --disable-sandboxing --bare --no-setup
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
      sh -s -- -y --default-toolchain none

ENV RUSTC_WRAPPER=sccache \
    SCCACHE_CACHE_SIZE=5G

# ---------------------------------------------------------------------------
# Layer 4: nvm + Node.js
# ---------------------------------------------------------------------------
ENV NVM_DIR=/home/dev/.nvm

RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash && \
    . "$NVM_DIR/nvm.sh" && \
    nvm install "$NODE_VERSION" && \
    rm -rf "$NVM_DIR/.cache"

# ---------------------------------------------------------------------------
# Layer 5: Foundry (forge)
# ---------------------------------------------------------------------------
RUN curl -L https://foundry.paradigm.xyz | bash && \
    /home/dev/.foundry/bin/foundryup -i "$FORGE_VERSION"

ENV PATH="/home/dev/.foundry/bin:${PATH}"

# ---------------------------------------------------------------------------
# Layer 6: Check out the exact commit resolved before the Docker build
# ---------------------------------------------------------------------------
FROM toolchain AS source
ARG GIT_COMMIT
RUN if [[ ! "${GIT_COMMIT:-}" =~ ^[0-9a-f]{40}$ ]]; then \
      echo 'GIT_COMMIT must be a full commit SHA; use scripts/resolve-tezos-commit.sh' >&2; \
      exit 1; \
    fi && \
    git init /home/dev/tezos && \
    cd /home/dev/tezos && \
    git remote add origin https://gitlab.com/tezos/tezos.git && \
    git fetch --depth 1 origin "$GIT_COMMIT" && \
    git checkout --detach FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = "$GIT_COMMIT"
LABEL org.tezos.revision=$GIT_COMMIT
WORKDIR /home/dev/tezos

# Only dependency inputs cross into this stage. COPY uses their content, so a
# new source commit with unchanged dependencies reuses toolchain/opam layers.
FROM toolchain AS dependencies
WORKDIR /home/dev/tezos
COPY --from=source --chown=dev:dev /home/dev/tezos/scripts/version.sh /home/dev/tezos/scripts/install_build_deps.sh /home/dev/tezos/scripts/install_build_deps.rust.sh ./scripts/
COPY --from=source --chown=dev:dev /home/dev/tezos/rust-toolchain ./rust-toolchain
COPY --from=source --chown=dev:dev /home/dev/tezos/opam/virtual/ ./opam/virtual/
COPY scripts/install-opam-deps.sh /usr/local/bin/install-opam-deps

# ---------------------------------------------------------------------------
# Layer 7: Version drift detection + update
# If the repo pins different versions than what we installed, update in place.
# ---------------------------------------------------------------------------
RUN . scripts/version.sh && \
    # Always provision the pinned toolchain and targets: rustc may auto-install
    # the toolchain from rust-toolchain before a version comparison runs.
    rustup toolchain install "$recommended_rust_version" && \
    rustup default "$recommended_rust_version" && \
    rustup target add --toolchain "$recommended_rust_version" \
      wasm32-unknown-unknown \
      riscv64gc-unknown-none-elf \
      riscv64gc-unknown-linux-gnu \
      riscv64gc-unknown-linux-musl \
      x86_64-unknown-linux-musl && \
    # Node drift
    . "$NVM_DIR/nvm.sh" && \
    current_node="$(node --version | sed 's/^v//')" && \
    if [ "$current_node" != "$recommended_node_version" ]; then \
      echo "Node drift: $current_node -> $recommended_node_version" && \
      nvm install "$recommended_node_version"; \
    fi

# Stable Node.js symlink so it's on PATH without sourcing nvm.sh
RUN . "$NVM_DIR/nvm.sh" && ln -sf "$(dirname "$(which node)")" "$NVM_DIR/current"
ENV PATH=$NVM_DIR/current:${PATH}

# ---------------------------------------------------------------------------
# Layer 8-9: OCaml build dependencies (uses BuildKit cache mounts)
# ---------------------------------------------------------------------------
RUN --mount=type=cache,id=tezos-dev-opam-downloads,target=/home/dev/.opam/download-cache,uid=1000,gid=1000 \
    install-opam-deps

ENV OPAM_SWITCH_PREFIX=/home/dev/tezos/_opam \
    CAML_LD_LIBRARY_PATH=/home/dev/tezos/_opam/lib/stublibs:/home/dev/tezos/_opam/lib/ocaml/stublibs:/home/dev/tezos/_opam/lib/ocaml \
    OCAML_TOPLEVEL_PATH=/home/dev/tezos/_opam/lib/toplevel \
    PATH=/home/dev/tezos/_opam/bin:${PATH}

# Merge the complete checkout only after installing dependencies. Its _opam
# switch remains at the same absolute path used when it was created.
FROM dependencies AS prepared
COPY --from=source --chown=dev:dev /home/dev/tezos/ /home/dev/tezos/
ARG GIT_COMMIT
LABEL org.tezos.revision=$GIT_COMMIT

# ---------------------------------------------------------------------------
# Layer 10: Kernel dependencies
# ---------------------------------------------------------------------------
RUN make -f kernels.mk build-deps && \
    make -f etherlink.mk build-deps && \
    mkdir -p _build/.cargo-target/default

RUN echo '[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"' >> /home/dev/.bashrc

# Opt into upstream incremental Rust release builds for the dev profile.
# Inherited by the nightly image and interactive development containers.
ENV OCTEZ_RUST_INCREMENTAL=1

# The compile stage commits cache snapshots alongside its build outputs. Final
# layers import each artifact group separately, including on a fresh builder.
FROM prepared AS build
COPY scripts/build-tezos.sh /usr/local/bin/build-tezos
RUN --mount=type=cache,id=tezos-dev-cargo-rust-deps,target=/home/dev/tezos/_build/.cargo-target/default/rust-deps,sharing=locked,uid=1000,gid=1000 \
    --mount=type=cache,id=tezos-dev-cargo-rustzcash,target=/home/dev/tezos/_build/.cargo-target/default/rustzcash,sharing=locked,uid=1000,gid=1000 \
    --mount=type=cache,id=tezos-dev-cargo-evm-runtime,target=/home/dev/tezos/_build/.cargo-target/default/evm-runtime,sharing=locked,uid=1000,gid=1000 \
    --mount=type=cache,id=tezos-dev-cargo-rollup-node,target=/home/dev/tezos/_build/.cargo-target/default/rollup-node,sharing=locked,uid=1000,gid=1000 \
    --mount=type=cache,id=tezos-dev-cargo-libcrux,target=/home/dev/tezos/_build/.cargo-target/default/libcrux,sharing=locked,uid=1000,gid=1000 \
    --mount=type=cache,id=tezos-dev-cargo-riscv-kernels,target=/home/dev/tezos/_build/.cargo-target/default/riscv-kernels,sharing=locked,uid=1000,gid=1000 \
    --mount=type=cache,id=tezos-dev-cargo-kernel-sdk,target=/home/dev/tezos/src/kernel_sdk/target,sharing=locked,uid=1000,gid=1000 \
    --mount=type=cache,id=tezos-dev-cargo-evm-kernel,target=/home/dev/tezos/etherlink/kernel_latest/target,sharing=locked,uid=1000,gid=1000 \
    --mount=type=cache,id=tezos-dev-cargo-git,target=/home/dev/.cargo/git,sharing=locked,uid=1000,gid=1000 \
    --mount=type=cache,id=tezos-dev-cargo-registry,target=/home/dev/.cargo/registry,sharing=locked,uid=1000,gid=1000 \
    --mount=type=bind,from=prepared,source=/home/dev/.cargo,target=/mnt/base-cargo \
    --mount=type=bind,from=prepared,source=/home/dev/tezos,target=/mnt/base-tezos \
    build-tezos base

FROM prepared AS development
# Keep tools downloaded by the build (for example solc) as well as shell setup.
RUN --mount=type=bind,from=build,source=/home/dev,target=/mnt/build-home \
    rsync -aH --checksum --delete --exclude=/tezos --exclude=/.cargo/git --exclude=/.cargo/registry /mnt/build-home/ /home/dev/
RUN --mount=type=bind,from=build,source=/home/dev/tezos,target=/mnt/build-tezos \
    rsync -aH --checksum --delete --exclude=/_opam --exclude=/_build/.cargo-target \
      --exclude=/src/kernel_sdk/target --exclude=/etherlink/kernel_latest/target \
      /mnt/build-tezos/ /home/dev/tezos/
RUN --mount=type=bind,from=build,source=/opt/cargo-export/rust-deps,target=/mnt/build-cargo \
    mkdir -p /home/dev/tezos/_build/.cargo-target/default/rust-deps && \
    rsync -aH --checksum --delete /mnt/build-cargo/ /home/dev/tezos/_build/.cargo-target/default/rust-deps/
RUN --mount=type=bind,from=build,source=/opt/cargo-export/rustzcash,target=/mnt/build-cargo \
    mkdir -p /home/dev/tezos/_build/.cargo-target/default/rustzcash && \
    rsync -aH --checksum --delete /mnt/build-cargo/ /home/dev/tezos/_build/.cargo-target/default/rustzcash/
RUN --mount=type=bind,from=build,source=/opt/cargo-export/evm-runtime,target=/mnt/build-cargo \
    mkdir -p /home/dev/tezos/_build/.cargo-target/default/evm-runtime && \
    rsync -aH --checksum --delete /mnt/build-cargo/ /home/dev/tezos/_build/.cargo-target/default/evm-runtime/
RUN --mount=type=bind,from=build,source=/opt/cargo-export/rollup-node,target=/mnt/build-cargo \
    mkdir -p /home/dev/tezos/_build/.cargo-target/default/rollup-node && \
    rsync -aH --checksum --delete /mnt/build-cargo/ /home/dev/tezos/_build/.cargo-target/default/rollup-node/
RUN --mount=type=bind,from=build,source=/opt/cargo-export/libcrux,target=/mnt/build-cargo \
    mkdir -p /home/dev/tezos/_build/.cargo-target/default/libcrux && \
    rsync -aH --checksum --delete /mnt/build-cargo/ /home/dev/tezos/_build/.cargo-target/default/libcrux/
RUN --mount=type=bind,from=build,source=/opt/cargo-export/riscv-kernels,target=/mnt/build-cargo \
    mkdir -p /home/dev/tezos/_build/.cargo-target/default/riscv-kernels && \
    rsync -aH --checksum --delete /mnt/build-cargo/ /home/dev/tezos/_build/.cargo-target/default/riscv-kernels/
RUN --mount=type=bind,from=build,source=/opt/cargo-export/kernel-sdk,target=/mnt/build-cargo \
    mkdir -p /home/dev/tezos/src/kernel_sdk/target && \
    rsync -aH --checksum --delete /mnt/build-cargo/ /home/dev/tezos/src/kernel_sdk/target/
RUN --mount=type=bind,from=build,source=/opt/cargo-export/evm-kernel,target=/mnt/build-cargo \
    mkdir -p /home/dev/tezos/etherlink/kernel_latest/target && \
    rsync -aH --checksum --delete /mnt/build-cargo/ /home/dev/tezos/etherlink/kernel_latest/target/
RUN --mount=type=bind,from=build,source=/opt/cargo-export/cargo-git,target=/mnt/build-cargo \
    mkdir -p /home/dev/.cargo/git && \
    rsync -aH --checksum --delete /mnt/build-cargo/ /home/dev/.cargo/git/
RUN --mount=type=bind,from=build,source=/opt/cargo-export/cargo-registry,target=/mnt/build-cargo \
    mkdir -p /home/dev/.cargo/registry && \
    rsync -aH --checksum --delete /mnt/build-cargo/ /home/dev/.cargo/registry/

WORKDIR /home/dev/tezos
CMD ["/bin/bash"]
